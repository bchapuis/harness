# /etc/harness/gateway.env — a harness-gateway's configuration.
#
# Mode 0640, owned root:harness.

# This gateway's node id. Outside the voters' range by convention (100+), unique
# among gateways, and it must appear in every node's HARNESS_CLIENTS. A gateway the
# nodes do not admit joins nothing and serves nothing.
HARNESS_NODE_ID=100

# The hostname the nodes dial to reach this gateway. Must match the --client entry
# the nodes were given for this id.
HARNESS_ADVERTISE_HOST=gw-1.internal.example

# The voter roster — identical to the nodes' own, and the same count.
HARNESS_NODES=3
HARNESS_PEERS="--peer 1=node-1.internal.example --peer 2=node-2.internal.example --peer 3=node-3.internal.example"

# Where the actor transport binds (cluster-facing, private network).
HARNESS_BIND_HOST=0.0.0.0

# Where tenant HTTP is served. This is the ONLY tenant-facing port in the deployment.
# Terminate public TLS in front of it (see deploy/systemd/README.md); the bearer
# tokens in /etc/harness/tenants are credentials and must not cross a plaintext link.
HARNESS_HTTP_BIND=0.0.0.0:8080

# The same cluster secret every node presents.
HARNESS_SECRET=replace-me
