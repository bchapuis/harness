# An agent-gateway on bare metal: the cluster's only tenant-facing process.
#
# The gateway joins the same cluster as a non-voting, non-hosting CLIENT (the Orleans
# cluster-client pattern). It verifies a caller's bearer token to a tenant, then
# addresses the session's entity directly over the actor transport: no forwarding hop.
# Because it holds `EntityRef`s and rides the receptionist gossip it sits INSIDE the
# cluster's trust boundary and presents the cluster secret; untrusted callers reach it
# only over HTTP with a bearer token.
#
# Run it on its own machine, or at least give it its own node id. It is stateless
# (no --data, nothing to replicate), so unlike a node it can be restarted freely.
#
# Install: as for agent-node, with /etc/agent/gateway.env.

[Unit]
Description=agent-gateway (cluster client, tenant-facing HTTP)
Documentation=file:///usr/share/doc/agent/standalone-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=agent
Group=agent
EnvironmentFile=/etc/agent/gateway.env
ExecStart=/usr/local/bin/agent-gateway \
    --bind ${AGENT_HTTP_BIND} \
    --node-id ${AGENT_NODE_ID} \
    --nodes ${AGENT_NODES} \
    --bind-host ${AGENT_BIND_HOST} \
    --advertise-host ${AGENT_ADVERTISE_HOST} \
    --auth-tokens /etc/agent/tenants \
    --secret ${AGENT_SECRET} \
    $AGENT_PEERS

# As on a node, the secret is an argument and so visible in `ps` locally.

# On SIGTERM the gateway flips /readyz to 503 and drains in-flight requests. Give it
# room to finish them: a request cut off here is a tenant's prompt lost, and the
# gateway holds no state that a retry can reconstruct.
KillSignal=SIGTERM
TimeoutStopSec=60

Restart=on-failure
RestartSec=5s

# Fronts every tenant: one connection per caller plus its transport associations to
# every node. Lower than a node's (it opens no segment files) but still well above
# the default 1024.
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Stateless: it needs no writable path at all.

[Install]
WantedBy=multi-user.target
