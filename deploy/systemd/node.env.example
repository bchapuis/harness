# /etc/harness/node.env — a harness-standalone node's configuration.
#
# Mode 0640, owned root:harness. It carries the cluster secret and the API key, and
# the node reads it as the `harness` user.
#
# Everything except HARNESS_NODE_ID and HARNESS_ADVERTISE_HOST is identical on every
# machine in the cluster. Several values MUST agree cluster-wide and are called out
# below; a mismatch is not always a startup failure, which is what makes them worth
# checking before the first boot rather than after.

# --- Identity -----------------------------------------------------------------

# This node's id: 1-based, unique, and STABLE ACROSS RESTARTS. The Raft voter state
# under --data belongs to this id (spec §9.4.3 item 2); starting a node on another
# node's directory, or reusing an id whose machine was replaced, is how a cluster
# gets two voters that both believe they hold one vote.
#
# A node that was declared `down` must NOT rejoin under the same id: wipe its data
# directory and give it a fresh one (actor spec §3.6, §9.1).
HARNESS_NODE_ID=1

# There is no separate "advertise host" for a node: the address peers dial for it is
# its own entry in HARNESS_PEERS below, keyed by HARNESS_NODE_ID. That is why the
# roster is identical everywhere and must include this machine.

# --- Cluster ------------------------------------------------------------------

# Total voter count. MUST match the --peer roster below and be identical on every
# node: it is how each node knows when it has discovered enough peers to serve.
HARNESS_NODES=3

# The full peer roster, one --peer per voter, INCLUDING this node. Identical on every
# machine — the id→host mapping is the cluster's shared view of who is who.
HARNESS_PEERS="--peer 1=node-1.internal.example --peer 2=node-2.internal.example --peer 3=node-3.internal.example"

# Non-voting cluster clients (gateways) admitted into the receptionist gossip, by id.
# Ids are outside the voter range by convention (100+). An admitted client that is not
# up yet simply dials in later, so these hosts need not resolve at boot. Leave empty
# if no gateway fronts this cluster.
HARNESS_CLIENTS="--client 100=gw-1.internal.example --client 101=gw-2.internal.example"

# Where the transport listens. 0.0.0.0 is correct on a private network: the node has
# no client-facing listener at all, and the transport handshake is guarded by the
# cluster secret. On a machine with a public NIC, bind the private address.
HARNESS_BIND_HOST=0.0.0.0

# The transport port. Node i binds HARNESS_PORT_BASE + i - 1, so with the default a
# three-node cluster uses 7401/7402/7403. On bare metal each node has the port to
# itself, but the base must still be identical everywhere: it is how a peer computes
# the port for an id it has only a hostname for.
HARNESS_PORT_BASE=7401

# --- Secrets ------------------------------------------------------------------

# The shared secret guarding the transport handshake. Every node AND every gateway
# must present the same one. Generate once (`openssl rand -hex 32`) and distribute.
HARNESS_SECRET=replace-me

# The model API key.
ANTHROPIC_API_KEY=replace-me

# --- Behaviour ----------------------------------------------------------------

# The model. MUST be identical on every node: it is covered by the kind digest that
# `SessionCreated` pins, so a cluster running two models fails to agree rather than
# silently splitting.
HARNESS_MODEL=claude-sonnet-4-6

# Sandbox tier: `durable` (typed file tools, no guest shell — what the hardened unit
# supports), `docker`, or `firecracker`. Also digest-covered, so it too must be
# identical cluster-wide; a mixed-mode cluster fails to agree instead of silently
# splitting confinement. The latter two need a relaxed unit (see harness-node.service).
HARNESS_SANDBOX=durable
